{
  "expo": {
    "name": "FAUCON",
    "slug": "faucon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-font-bleu.jpeg",
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FAUCON utilise votre position pour calculer la distance avec vos équipements.",
        "NSLocationAlwaysUsageDescription": "FAUCON utilise votre position pour calculer la distance avec vos équipements.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.faucon.tracking"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.faucon.tracking",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-font-bleu.jpeg",
        "backgroundColor": "#002D72"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FAUCON utilise votre position pour calculer la distance avec vos équipements."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/grande-icone-font-blanc.jpeg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#002D72"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "17dcca0e-afb8-4f5e-8fa5-df4c1dd1f320"
      }
    }
  }
}
