# Copie ce fichier en `.env` et renseigne les valeurs.
# Ne jamais committer `.env` (clés API, secrets).
# Le préfixe EXPO_PUBLIC_ rend la variable accessible côté client.

EXPO_PUBLIC_API_URL=https://<hôte-du-serveur>
EXPO_PUBLIC_SOCKET_URL=https://<hôte-du-serveur>

# Clés de tuiles cartographiques (fournies par l'équipe) — REQUISES pour
# afficher les fonds de carte. Si vides, le style est désactivé dans la sidebar.
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_STADIA_KEY=
